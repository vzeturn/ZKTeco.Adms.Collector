<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site configuration for the ADMS attendance collector.

  AspNetCoreModuleV2 (ANCM) starts `python -m adms.hosting.serve` and reverse-proxies to it on a
  loopback port that IIS chooses (passed to the child as ASPNETCORE_PORT), in out-of-process hosting
  mode. IIS therefore owns port 80, the access log, auto-start and recycling; the Python process only
  ever sees a normal WSGI request.

  PREREQUISITE: the AspNetCoreModuleV2 module must be installed. It ships with the ASP.NET Core /
  .NET Hosting Bundle (not with a bare IIS install). deploy/install-iis.ps1 checks for it and tells
  you where to get it. This machine has ANCM but not HttpPlatformHandler; the two are functionally
  interchangeable reverse proxies for a child process.

  WHY NOT wfastcgi: it is a FastCGI bridge that has been only lightly maintained, and it couples the
  request model to IIS. ANCM keeps the Python side a plain WSGI app, which is what lets
  tools/smoke_test.py exercise the exact same code path with no IIS at all.

  SECURITY NOTE: there is no authentication here, and that is a property of the ADMS protocol rather
  than an omission. A device announces a serial number in a query string and cannot send a header, a
  token or a client certificate. What protects this endpoint is (1) putting the site on a network
  segment only the devices can reach, (2) the serial allow-list in dbo.ADMS_DEVICE which the
  application enforces on every request, and (3) optionally ADMS_PATH_SECRET. Adding IIS
  authentication would break every device.

  NOTE ON EDITING: XML forbids a double hyphen inside a comment, so the prose here uses single
  punctuation deliberately. build.ps1 parses this file as XML on every run to catch that mistake.
-->
<configuration>

  <system.webServer>

    <handlers>
      <!-- Remove any inherited handler from a parent configuration before adding ours; otherwise the
           first matching handler wins and it may not be this one. -->
      <remove name="aspNetCore" />
      <add name="aspNetCore"
           path="*"
           verb="*"
           modules="AspNetCoreModuleV2"
           resourceType="Unspecified" />
    </handlers>

    <!--
      processPath and arguments: EDIT THE PYTHON PATH to the site's virtual environment.
      install-iis.ps1 rewrites these paths for you when the site lives somewhere other than
      C:\inetpub\adms-collector. Pointing at the venv's python.exe directly means its site-packages is
      used without activating anything.

      hostingModel="OutOfProcess": ANCM launches the child and reverse-proxies to it, rather than
      loading a .NET assembly in-process. This is the mode a non-.NET (Python) child requires.

      stdoutLogEnabled: ANCM captures the child's stdout. Keep it on, because a process that fails to
      start is otherwise a bare 502 with nothing to read. It rotates on recycle rather than by date,
      which is why the application also writes a dated file (see ADMS_LOG_DIR).

      startupTimeLimit: the first request builds the object graph, decrypts the registry value and
      opens a SQL connection over the WAN. 60 seconds is generous, but a cold start killed at 10
      seconds looks exactly like a configuration fault and wastes an afternoon.

      requestTimeout: a device gives up at around 60 seconds, so IIS waiting longer serves no purpose.
    -->
    <aspNetCore processPath="C:\inetpub\adms-collector\.venv\Scripts\python.exe"
                arguments="-m adms.hosting.serve"
                hostingModel="OutOfProcess"
                stdoutLogEnabled="true"
                stdoutLogFile="C:\inetpub\adms-collector\logs\stdout"
                startupTimeLimit="60"
                requestTimeout="00:01:00"
                forwardWindowsAuthToken="false">
      <environmentVariables>
        <!-- ANCM assigns the loopback port via ASPNETCORE_PORT; serve.py reads it. The port is not
             passed as a command-line argument because arguments are not env-expanded. This flag makes
             ANCM forward X-Forwarded-For / X-Forwarded-Proto so the app records the real client IP. -->
        <environmentVariable name="ASPNETCORE_FORWARDEDHEADERS_ENABLED" value="true" />
        <!-- PYTHONPATH so `adms` resolves without an install step. Points at the src folder. -->
        <environmentVariable name="PYTHONPATH" value="C:\inetpub\adms-collector\src" />
        <!-- Unbuffered, or stdout lines appear minutes late in the ANCM stdout log. -->
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="PYTHONUTF8" value="1" />

        <!-- Dated JSON log, alongside the stdout capture above. -->
        <environmentVariable name="ADMS_LOG_DIR" value="C:\inetpub\adms-collector\logs" />
        <environmentVariable name="ADMS_LOG_LEVEL" value="INFO" />

        <!-- Error reporting to Sentry. Empty DSN = off. Set ADMS_SENTRY_DSN to the project's DSN (it
             only lets this host submit events, nothing else). Events carry no personal data: no
             request, no query string, no body, no local variables (see adms/observability.py). Check
             it by running python -m adms.hosting.serve with the sentry-test flag. -->
        <environmentVariable name="ADMS_SENTRY_DSN" value="" />
        <environmentVariable name="ADMS_SENTRY_ENVIRONMENT" value="production" />
        <environmentVariable name="ADMS_SENTRY_TRACES_SAMPLE_RATE" value="0.02" />

        <!-- Site offset from UTC, used for audit timestamps. -->
        <environmentVariable name="ADMS_UTC_OFFSET_HOURS" value="7" />

        <!-- getrequest poll interval, and therefore the worst-case latency of a queued command. Now
             that this is self-hosted it is no longer a cost lever, so it can stay short. -->
        <environmentVariable name="ADMS_POLL_DELAY" value="10" />
        <!-- How long a device waits after a non-2xx before retrying: the backstop that keeps
             unacknowledged punches on the device through an outage. -->
        <environmentVariable name="ADMS_ERROR_DELAY" value="30" />

        <!-- Verbatim archive of every upload, for replay and dispute resolution. Retention is a
             scheduled job: EXEC dbo.ADMS_PurgeArchives. -->
        <environmentVariable name="ADMS_ARCHIVE_RAW_BODIES" value="true" />

        <!-- Record unknown serials as DISABLED rows so they appear in dbo.vw_ADMS_DeviceStatus. This
             never grants access. Useful while commissioning; turn it off afterwards. -->
        <environmentVariable name="ADMS_AUTO_REGISTER_DEVICES" value="false" />

        <!-- Optional secret URL segment. If set, configure the device path as /THE_SECRET/iclock. -->
        <environmentVariable name="ADMS_PATH_SECRET" value="" />

        <!-- Auto-enrolment wording. Leave both empty to use DATA QUERY USERINFO PIN={pin} and
             DATA QUERY FINGERTMP PIN={pin}. Set one only if this site's firmware rejects the default:
             the symptom is a negative ReturnCode in dbo.ADMS_COMMAND after the first attempt, which
             means the device rejected the wording rather than the PIN. Either form works, with the
             {pin} placeholder or without it (PIN=<pin> is appended when it is absent). -->
        <environmentVariable name="ADMS_QUERY_USERINFO_COMMAND" value="" />
        <environmentVariable name="ADMS_QUERY_FINGERTMP_COMMAND" value="" />

        <!-- Waitress worker threads. Also the cap on concurrent SQL connections, since each thread
             holds its own. -->
        <environmentVariable name="ADMS_THREADS" value="8" />

        <!-- Skip TLS certificate validation on the SQL connection. Default false, so the certificate
             IS validated. A server may accept unencrypted sessions, so the client is the only
             party that can insist on encryption; TrustServerCertificate=no means the server
             certificate is actually checked. Only set true for a server with a self-signed
             certificate; for Amazon RDS run deploy/import-rds-ca.ps1 instead. -->
        <environmentVariable name="ADMS_SQL_TRUST_SERVER_CERT" value="false" />

        <!-- The SQL connection string is deliberately NOT here. It lives DPAPI-encrypted in
             HKLM\SOFTWARE\AdmsCollector\AttendanceDb; see deploy/set-db-connection.ps1. This file is
             plaintext, sits in the site folder, is overwritten by a redeploy and copied by every
             backup. -->
      </environmentVariables>
    </aspNetCore>

    <!--
      Device payloads: template and photo uploads run to a few megabytes. IIS defaults to a 28.6 MB
      request limit, which is fine. The URL and query limits matter more, because ADMS puts everything
      in the query string and some firmware sends long option lists.
    -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="33554432" maxQueryString="8192" maxUrl="4096" />
      </requestFiltering>
    </security>

    <!-- Do not advertise the platform to an unauthenticated device network. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- Pass through whatever the application returns, instead of replacing a 401 or 503 body with an
         IIS error page. This is essential: firmware reads the body, and some builds treat any response
         as a successful delivery, so an IIS HTML error page in place of our plain-text 503 would make
         a device discard the punches it had just uploaded. -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>

</configuration>
