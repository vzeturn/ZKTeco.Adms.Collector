# Local development only. On the IIS host these come from the <environmentVariables> block in
# deploy/web.config, not from a file.
#
# Copy to .env (gitignored) and load it yourself, or just set the variables in your shell.

# ADMS_SQL_CONNECTION is a DEVELOPMENT escape hatch. In production the connection string lives
# DPAPI-encrypted in HKLM\SOFTWARE\AdmsCollector\AttendanceDb (see deploy/set-db-connection.ps1),
# because web.config is plaintext, sits in the site folder, is overwritten by a redeploy and copied by
# every backup.
#
# Note the host is a DNS NAME, not an IP: a hostname lets DNS decide whether the server is reached
# publicly or privately.
ADMS_SQL_CONNECTION=DRIVER={ODBC Driver 18 for SQL Server};SERVER=sql.example.com,1433;DATABASE=ATTENDANCEDB;UID=adms_collector;PWD=change-me;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=10;

# Set to true only for a server with a self-signed certificate. It leaves the connection encrypted but
# unauthenticated, which stops passive sniffing and not an active man-in-the-middle. For Amazon RDS,
# run deploy/import-rds-ca.ps1 instead and leave this false.
ADMS_SQL_TRUST_SERVER_CERT=false

# Site offset from UTC, used for audit timestamps.
ADMS_UTC_OFFSET_HOURS=7

ADMS_LOG_LEVEL=DEBUG
# Empty means stdout only.
ADMS_LOG_DIR=

# Require this URL segment; devices are then configured with /THE_SECRET/iclock.
ADMS_PATH_SECRET=

# Record unknown serials as DISABLED rows so they show up in dbo.vw_ADMS_DeviceStatus. Never grants
# access. Useful while commissioning to discover serials.
ADMS_AUTO_REGISTER_DEVICES=false

ADMS_ARCHIVE_RAW_BODIES=true

# getrequest poll interval, and therefore the worst-case latency of a queued command.
ADMS_POLL_DELAY=10
# How long a device waits after a non-2xx before retrying.
ADMS_ERROR_DELAY=30

# Waitress worker threads. Also the cap on concurrent SQL connections, since each thread holds its own.
ADMS_THREADS=8

# Auto-enrolment wording. Empty means DATA QUERY USERINFO PIN={pin} and DATA QUERY FINGERTMP PIN={pin}.
# Only set these if the site's firmware rejects the default: the symptom is a negative ReturnCode in
# dbo.ADMS_COMMAND after the first attempt, which means the device rejected the wording, not the PIN.
# The accepted table token differs across builds (USERINFO / USER / userinfo), and this is the one part
# of the enrolment path not verified against hardware, so it is free text rather than a fixed list.
# Both forms work: with the {pin} placeholder, or without it, in which case PIN=<pin> is appended.
ADMS_QUERY_USERINFO_COMMAND=
ADMS_QUERY_FINGERTMP_COMMAND=

# Sentry error reporting. Empty = off. On a site, set the DSN of the adms-attendance project; events
# never carry personal data (see src/adms/observability.py). Test with --sentry-test on either serve.
ADMS_SENTRY_DSN=
ADMS_SENTRY_ENVIRONMENT=development
ADMS_SENTRY_TRACES_SAMPLE_RATE=0.02
